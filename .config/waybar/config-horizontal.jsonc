[
	{
		// Bar configuration
		"layer": "top",
		"position": "top",
		"height": 48,
		"spacing": 8,

		// Modules orders
		"modules-left": [
			"custom/os_icon",
			"hyprland/workspaces"
		],


		"modules-center": [
			"hyprland/window"
		],

		"modules-right": [
			"tray",
			"privacy",
			"group/system",	
			"clock"
		],

		// Groups
		"group/system": {
			"orientation": "horizontal",
			"modules": [
				"network",
				"bluetooth",
				"pulseaudio",
				"power-profiles-daemon",
				"battery"
			]
		},

		// Modules configurations
		"hyprland/workspaces": {
			"all-outputs": false,
			"format": "{icon}",
			"format-icons": {
				"default": "󰫢",
				"special": "󰫤"
			},
			"show-special": true,
			"special-visible-only": true
		},

		"hyprland/window": {
			"format": "{initialTitle}",
			"tooltip": false,
			"icon": true,
			"icon-size": 14,
			"max-length": 48,
			"rewrite": {
				"": " Desktop"
			}
		},

		"custom/os_icon": {
			"format": "󰣇",
			"tooltip": false,
            "on-click": "~/.config/waybar/scripts/switch_layout.sh"
		},

		"clock": {
			"format": "{:%H:%M}",
			"tooltip-format": "<tt>{calendar}</tt>",
			"format-alt": "{:%d/<span color='#e65050'>%m</span>/%y}",
			"calendar": {
				"mode"          : "year",
				"mode-mon-col"  : 3,
				"weeks-pos"     : "left",
				"on-scroll"     : 1,
				"format": {
					"months":     "<span color='#ffead3'><b>{}</b></span>",
					"days":       "<span color='#ffedc7'><b>{}</b></span>",
					"weeks":      "<span color='#454545'><b>{}</b></span>",
					"weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
					"today":      "<span color='#ff6699'><b>{}</b></span>"
				},
				"actions":  {
					"on-click-right": "mode",
					"on-click-forward": "tz_up",
					"on-click-backward": "tz_down",
					"on-scroll-up": "shift_up",
					"on-scroll-down": "shift_down"
				}
			}
		},

		"battery": {
			"interval" : 60,
			"states": {
					"warning": 35,
					"critical": 15
			},
			"format": "{icon}",
			"format-charging": "",
			"format-plugged": "",
			"format-icons": ["󰂎", "󰁼", "󰁾", "󰂀", "󰁹"],
			"tooltip-format": "Capacity: {capacity}%\n{power}W - {time}"
		},

		"bluetooth": {
			"format": "󰂯",
			"format-disabled": "󰂲",
			"format-connected": "󰂱",
			"tooltip-format": "{controller_alias}\t{controller_address}",
			"tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
			"tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
		},

		"tray": {
			"icon-size": 16,
			"spacing": 12,
			"icons": {
				"vesktop": "discord-white"
			}
		},

		"privacy": {
			"icon-size": 16,
			"icon-spacing": 12
		},

		"custom/media": {
			"format": "{}",
			"return-type": "json",
			"max-length": 90,
			"escape": false,
			"exec": "$HOME/.config/waybar/scripts/mediaplayer.py 2> /dev/null"
		},

		"pulseaudio": {
			"format": "{icon}",
			"format-bluetooth": "{icon}",
			"format-muted": "",
			"format-source": "",
			"format-source-muted": "",
			"format-icons": {
				"headphone": "",
				"hands-free": "󰋎",
				"headset": "󰋎",
				"phone": "",
				"portable": "",
				"car": "",
				"default": ["", ""]
			},
			"on-click": "pavucontrol"
		},

		"power-profiles-daemon": {
			"format": "{icon}",
			"tooltip-format": "Power profile: {profile}\nDriver: {driver}",
			"tooltip": true,
			"format-icons": {
				"default": "",
				"performance": "",
				"balanced": "",
				"power-saver": ""
			}
		},

		"network": {
			"format": "󰛳",
			"format-wifi": "",
			"format-disconnected": "<span color='#d92b2b'>⚠</span>",
			"tooltip-format": "{essid}\n{ifname} - {ipaddr}"
		}
	}
]
